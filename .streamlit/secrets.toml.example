# Copy these into Streamlit Cloud: your app -> Settings -> Secrets.
# Never commit a real secrets.toml to the repo.

[github]
token  = "github_pat_xxxxxxxxxxxxxxxx"   # fine-grained token, Contents: Read and write, this repo only
repo   = "your-github-username/model-portfolio"
branch = "main"
path   = "data/portfolio.json"

[app]
edit_pin = "1234"   # optional; remove this section to let anyone with the link edit
